manifest {
  name = 'ews-nf'
  description = 'A workflow for analyzing Ewing sarcoma single-cell RNA-sequencing samples.'
  homePage = 'https://github.com/AlexsLemonade/ews-nf'
  mainScript = 'main.nf'
  defaultBranch = 'main'
  nextflowVersion = '>=24.09'
  version = 'v0.1.0'
  contributors = [
    [
      name: "Allegra Hawkins",
      affiliation: "Alex's Lemonade Stand Foundation",
      contribution: ["author"],
      github: "https://github.com/allyhawkins",
      orcid: "https://orcid.org/0000-0001-6026-3660"
    ],
    [
      name: "Joshua A. Shapiro",
      affiliation: "Alex's Lemonade Stand Foundation",
      contribution: ["author"],
      github: "https://github.com/jashapiro",
      orcid: "https://orcid.org/0000-0002-6224-0347"
    ],
    [
      name: "Stephanie J. Spielman",
      affiliation: "Alex's Lemonade Stand Foundation",
      contribution: ["author"],
      github: "https://github.com/sjspielman",
      orcid: "https://orcid.org/0000-0002-9090-4788"
    ]
  ]
}

nextflow.enable.dsl = 2
nextflow.enable.moduleBinaries = true

plugins {
  id 'nf-schema@2.3.0'
}

// global parameters for workflows
params {
  // default workflow
  workflow = "annotation" // options are "reference", "annotation", "nmf_metaprograms"

  // Input data
  scpca_nf_dir = "scpca-nf-out"

  // Output directory
  outdir = "ews-nf-out"

  // a list of sample_ids
  // or "All" to process all samples in the output directory
  sample_ids = "All"

  // docker image for ews-nf 
  ews_nf_container = 'ghcr.io/alexslemonade/ews-nf:edge'

  // docker image for cnmf
  cnmf_container = 'ghcr.io/alexslemonade/ews-nf/cnmf:edge'

  // seed for reproducibility
  seed = 2025

  // metaprogram subset parameters
  subset_tsv = "${projectDir}/sample-info/sample-subsets.tsv" // tsv with sample id and subset id for grouping samples into metaprogram subsets; if not provided all samples will be included in a single group
  subset_mode = false // boolean indicating whether to run metaprograms on subsets of samples defined in subset_tsv; if false all samples will be included in a single group
  subset_ids = "All" // which subsets to process, use a comma separated string o subset_ids or `All` to run on all subsets defined in subset_tsv

}

profiles {
  standard {
    process {
      executor = 'local'
      resourceLimits = [ cpus: 4, memory: 16.GB ]
    }
    docker.enabled = true
    docker.runOptions = '--platform linux/amd64'
    aws.client.anonymous = true
  }
  // Pitt HTC profile
  pitt_htc {
    tower.enabled = true
    tower.workspaceId = '245143971198287'
    process {
      executor = 'slurm'
      queue = 'htc'
      resourceLimits = [cpus: 12, memory: 512.GB, time: 144.h]
      beforeScript = 'module load singularity'
      scratch = '$SLURM_SCRATCH'
    }
    singularity {
      enabled = true
      autoMounts = true
      cacheDir = "$HOME/.singularity-cache"
      pullTimeout = '1h' // specificy longer timeout than default of 20 min
    }
    docker.enabled = false
    aws.client.anonymous = true
  }
  // stub testing profile
  stub {
    params {
      scpca_nf_dir = "stub/scpca-nf-out"
      outdir = "stub/ews-nf-out"
      subset_tsv = "stub/sample-subsets.tsv"
    }
    process {
      executor = 'local'
      resourceLimits = [ cpus: 2, memory: 4.GB ]
    }
    docker.enabled = false
    aws.client.anonymous = true
  }
}

// Load base process config with labels
includeConfig 'config/process_base.config'

// include module specific parameters
// load these after defining the profiles so any parameters that use the outdir get properly defined
includeConfig 'config/module_params.config'
