{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ews-nf//nextflow_schema.json",
  "title": "ews-nf pipeline parameters",
  "description": "A workflow for analyzing Ewing sarcoma single-cell RNA-sequencing samples.",
  "type": "object",
  "$defs": {
    "global_parameters": {
      "title": "Global Parameters",
      "type": "object",
      "description": "",
      "default": "",
      "properties": {
        "outdir": {
          "type": "string",
          "format": "directory-path",
          "description": "The output directory where the results will be saved. You have to use absolute paths to storage on Cloud infrastructure.",
          "fa_icon": "fas fa-folder-open",
          "default": "ews-nf-out"
        },
        "scpca_nf_dir": {
          "type": "string",
          "default": "scpca-nf-out",
          "description": "Path to directory containing output files from running scpca-nf"
        },
        "sample_ids": {
          "type": "string",
          "default": "All",
          "description": "List of sample IDs to process, must match the folder names in scpca_nf_dir"
        },
        "seed": {
          "type": "integer",
          "default": 2025,
          "description": "Random seed"
        }
      }
    },
      "containers": {
      "title": "Containers",
      "type": "object",
      "description": "Locations for Docker images used by workflow processes",
      "default": "",
      "properties": {
        "ews_nf_container": {
          "type": "string",
          "default": "ghcr.io/alexslemonade/ews-nf:edge",
          "description": "Container to use for running individual modules"
        }
      }
    },
    "module_specific_parameters": {
      "title": "Module-specific parameters",
      "type": "object",
      "description": "Parameters used by individual modules",
      "default": "",
      "properties": {
        "custom_genesets_file": {
          "type": "string",
          "default": "${projectDir}/genesets/custom-gene-sets.tsv",
          "pattern": "\\.tsv$",
          "format": "file-path",
          "mimetype": "text/tab-separated-values",
          "description": "Table of custom gene sets"
        },
        "msigdb_genesets_file": {
          "type": "string",
          "default": "${projectDir}/genesets/msigdb-gene-sets.tsv",
          "pattern": "\\.tsv$",
          "format": "file-path",
          "mimetype": "text/tab-separated-values",
          "description": "Table of MSigDB gene sets"
        },
        "aucell_max_rank_threshold": {
          "type": "number",
          "default": 0.01,
          "description": "Proportion of detected genes to use as the threshold for the max AUC rank when running AUCell"
        },
        "ref_celltypes_file": {
          "type": "string",
          "default": "${projectDir}/references/reference-celltypes.tsv",
          "pattern": "\\.tsv$",
          "format": "file-path",
          "mimetype": "text/tab-separated-values",
          "description": "Table of consensus cell type annotations to include when building the normal reference"
        },
        "gtf_file": {
          "type": "string",
          "default": "s3://scpca-references/homo_sapiens/ensembl-104/annotation/Homo_sapiens.GRCh38.104.gtf.gz",
          "pattern": "\\.gtf.gz$",
          "format": "file-path",
          "mimetype": "text/tab-separated-values",
          "description": "Path to GTF reference file used for mapping in scpca-nf"
        },
        "validation_groups_file": {
          "type": "string",
          "default": "${projectDir}/references/consensus-validation-groups.tsv",
          "pattern": "\\.tsv$",
          "format": "file-path",
          "mimetype": "text/tab-separated-values",
          "description": "Path to TSV file mapping consensus cell type groups to broad validation groups"
        },
        "marker_genes_file": {
          "type": "string",
          "default": "${projectDir}/references/validation-markers.tsv",
          "pattern": "\\.tsv$",
          "format": "file-path",
          "mimetype": "text/tab-separated-values",
          "description": "Path to TSV file containing marker genes for all consensus cell type validation groups"
        },
        "color_palette_file": {
          "type": "string",
          "default": "${projectDir}/palettes/validation-group-palette.tsv",
          "pattern": "\\.tsv$",
          "format": "file-path",
          "mimetype": "text/tab-separated-values",
          "description": "Path to TSV file containing hex codes to use for coloring each consensus cell type validation group"
        }

      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/global_parameters"
    },
    {
      "$ref": "#/$defs/containers"
    },
    {
      "$ref": "#/$defs/module_specific_parameters"
    }
  ]
}
