// Module specific parameters are defined here
params{

  // reference parameters 
  ref_celltypes_file = "${projectDir}/references/reference-celltypes.tsv"
  ref_sce_file = "${params.outdir}/reference/all-ref-sce.rds"
  ref_annotations_file = "${params.outdir}/reference/all-ref-annotations.tsv"

  // infercnv reference parameters
  gtf_file = 's3://scpca-nf-references/homo_sapiens/ensembl-110/annotation/Homo_sapiens.GRCh38.110.gtf.gz'
  gene_order_file = "${params.outdir}/reference/Homo_sapiens.GRCh38.110.gene_order.txt"

  // infercnv run parameters
  skip_infercnv = false // skip running infercnv if results already exist 

  // aucell parameters
  custom_genesets_file = "${projectDir}/genesets/custom-gene-sets.tsv"
  msigdb_genesets_file = "${projectDir}/genesets/msigdb-gene-sets.tsv"
  aucell_max_rank_threshold = 0.01 // Proportion of genes detected to set as max AUC rank 

  // annotate tumor cell parameters
  // used to classify tumor cells into tumor-high and tumor-low
  marker_gene_cutoff = 2
  annotations_output_dir = "${params.outdir}/annotations"
  no_annotations_file = "${projectDir}/references/no_annotations_file.tsv" // empty placeholder file used in place of a sample's annotations file when none is found; when used, cells are subset using the annotations_column in the object's cell metadata (.obs/colData) if present, otherwise all cells are included in cNMF and metaprogram scoring

  // summary report parameters 
  validation_groups_file = "${projectDir}/references/consensus-validation-groups.tsv"
  marker_genes_file = "${projectDir}/references/validation-markers.tsv"
  color_palette_file = "${projectDir}/palettes/validation-group-palette.tsv"
  gene_set_category_file = "${projectDir}/genesets/gene-set-categories.tsv"

  // cnmf parameters
  annotations_column = "annotation_tier0" // Column name in the annotations file containing the cell type annotations to use for cNMF
  celltype_value = "tumor" // Value in the annotations column corresponding to the cell type to use for cNMF
  k_components_lower = 5 // lower bound for number of components to run with cNMF
  k_components_upper = 15 // upper bound for number of components to run with cNMF
  k_step_size = 5 // Step size to use for creating the range of k components to run with cNMF
  skip_cnmf = false // skip running cnmf if results directory exists

  // metaprograms parameters
  cnmf_k_range = "all" // Set of k values used with cNMF to keep when clustering spectra into metaprograms, comma separated. Use 'all' to use all available k.
  n_metaprograms = "8,9,10,11" // Comma separated string indicating the range of number of metaprograms to use for finding the optimal k; use at least 4 values 
  filter_spectra = false // Boolean indicating whether to filter orphan spectra prior to generating metaprograms
  orphan_cutoff = 0.3 // Minimum cross sample maximum required to keep spectra if filter_spectra is true
  repeat_creating_metaprograms = false // re-create metaprograms if results already exist
  score_sces = false // boolean indicating whether to score and annotate sces with the optimal value of k

  // metaprogam metrics parameters
  nreps = 1000 // Number of permutations to use for metrics that use permutation testing
  sample_metadata_file = "${projectDir}/sample-info/sample-metadata.tsv" // sample metadata file with sample id, participant id and diseaes timing information
  hallmark_reactome_genesets_file = "${projectDir}/genesets/hallmark-reactome-gene-sets.tsv" // pre-downloaded Hallmark and Reactome gene sets from MSigDB used for ORA
  
}
